{
  "name": "bahaa-portfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "lodash": "4.18.1",
    "recharts": {
      "lodash": "4.18.1"
    }
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @portfolio/web",
    "dev:admin": "npm run dev --workspace @portfolio/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:admin": "npm audit --workspace @portfolio/admin --omit=dev --audit-level=moderate",
    "audit:web": "npm audit --workspace @portfolio/web --omit=dev --audit-level=moderate",
    "audit:security": "npm run audit:admin && npm run audit:web",
    "migrate:projects": "node scripts/migrate-projects.mjs",
    "migrate:storage-paths": "node scripts/migrate-storage-paths.mjs",
    "admin:claim": "node scripts/admin-claim.mjs"
  }
}
